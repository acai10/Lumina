# Lumina environment configuration — copy this file to `.env` (same directory as
# docker-compose.yml) and adjust the values. Docker Compose loads `.env`
# automatically on every `docker compose up`, so this works identically on
# Windows, macOS and Linux — no inline shell variables needed.
#
# Quick start:
#   1. Copy:  cp .env.example .env       (Windows: copy .env.example .env)
#   2. Edit LUMINA_DATA_DIR below.
#   3. Run:   docker compose up --build

# Absolute host path to the directory that holds your source .h5 files. It is
# bind-mounted READ-ONLY into the backend at /data, so the originals are never
# modified. Leave it as ./data to use the repository's local data folder.
#
# Examples:
#   macOS / Linux:  LUMINA_DATA_DIR=/Users/you/oct-data
#   Windows:        LUMINA_DATA_DIR=C:\Users\you\oct-data
LUMINA_DATA_DIR=./data
